[
  {
    "name": "ProRes HQ · Schnittmaster",
    "suffix": "_prores_hq",
    "extension": "mov",
    "command": "ffmpeg -i \"{input}\" -map 0:v:0 -map 0:a? -c:v prores_ks -profile:v 3 -pix_fmt yuv422p10le -c:a pcm_s24le \"{output}\""
  },
  {
    "name": "H.264 · hohe Qualität",
    "suffix": "_h264_hq",
    "extension": "mp4",
    "command": "ffmpeg -i \"{input}\" -map 0:v:0 -map 0:a? -c:v libx264 -preset slow -crf 18 -pix_fmt yuv420p -c:a aac -b:a 192k -movflags +faststart \"{output}\""
  },
  {
    "name": "H.264 · schnell",
    "suffix": "_h264_fast",
    "extension": "mp4",
    "command": "ffmpeg -i \"{input}\" -map 0:v:0 -map 0:a? -c:v libx264 -preset veryfast -crf 23 -pix_fmt yuv420p -c:a aac -b:a 160k -movflags +faststart \"{output}\""
  },
  {
    "name": "H.265 · hohe Qualität",
    "suffix": "_h265_hq",
    "extension": "mp4",
    "command": "ffmpeg -i \"{input}\" -map 0:v:0 -map 0:a? -c:v libx265 -preset medium -crf 22 -tag:v hvc1 -c:a aac -b:a 192k -movflags +faststart \"{output}\""
  },
  {
    "name": "H.265 · schnell",
    "suffix": "_h265_fast",
    "extension": "mp4",
    "command": "ffmpeg -i \"{input}\" -map 0:v:0 -map 0:a? -c:v libx265 -preset fast -crf 26 -tag:v hvc1 -c:a aac -b:a 160k -movflags +faststart \"{output}\""
  },
  {
    "name": "Audio extrahieren · WAV 24 Bit",
    "suffix": "_audio_wav",
    "extension": "wav",
    "command": "ffmpeg -i \"{input}\" -map 0:a:0 -vn -c:a pcm_s24le \"{output}\""
  },
  {
    "name": "Audio extrahieren · MP3 320k",
    "suffix": "_audio_mp3_320k",
    "extension": "mp3",
    "command": "ffmpeg -i \"{input}\" -map 0:a:0 -vn -c:a libmp3lame -b:a 320k \"{output}\""
  },
  {
    "name": "Audio ersetzen · Video kopieren",
    "suffix": "_new_audio",
    "extension": "mov",
    "command": "ffmpeg -i \"{input}\" -i \"{audio}\" -map 0:v:0 -map 1:a:0 -c:v copy -c:a pcm_s24le -af apad -shortest \"{output}\""
  },
  {
    "name": "MP4 · Streams kopieren",
    "suffix": "_remux_mp4",
    "extension": "mp4",
    "command": "ffmpeg -i \"{input}\" -map 0 -c copy \"{output}\""
  },
  {
    "name": "25 → 24 fps · Timescale",
    "suffix": "_24fps_timescale24000",
    "extension": "mov",
    "command": "ffmpeg -itsscale 1.0416666666666667 -i \"{input}\" -map 0:v:0 -c:v copy -an -video_track_timescale 24000 -map_metadata -1 \"{output}\""
  },
  {
    "name": "H.264 · 1080p · Seitenverhältnis",
    "suffix": "_h264_1080p",
    "extension": "mp4",
    "command": "ffmpeg -i \"{input}\" -map 0:v:0 -map 0:a? -vf \"scale=1920:1080:force_original_aspect_ratio=decrease:force_divisible_by=2:reset_sar=1\" -c:v libx264 -preset medium -crf 20 -pix_fmt yuv420p -c:a aac -b:a 192k -movflags +faststart \"{output}\""
  },
  {
    "name": "H.264 · 720p · Seitenverhältnis",
    "suffix": "_h264_720p",
    "extension": "mp4",
    "command": "ffmpeg -i \"{input}\" -map 0:v:0 -map 0:a? -vf \"scale=1280:720:force_original_aspect_ratio=decrease:force_divisible_by=2:reset_sar=1\" -c:v libx264 -preset medium -crf 20 -pix_fmt yuv420p -c:a aac -b:a 192k -movflags +faststart \"{output}\""
  }
]
